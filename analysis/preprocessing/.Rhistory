factor_mapping <- data.frame(
string = levels(factor_variable),
factor_number = 0:(length(levels(factor_variable))-1)
)
# Function to get the factor mapping
factor_mapping <- function(factor_variable) {
factor_mapping <- data.frame(
string = levels(factor_variable),
factor_number = 0:(length(levels(factor_variable))-1)
)
}
factor_mapping(cd$Year)
print(factor_mapping(cd$Year))
