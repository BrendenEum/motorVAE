# Function to get the factor mapping
factor_mapping <- function(factor_variable, fn) {
mapping <- data.frame(
string = levels(factor_variable),
factor_number = 0:(length(levels(factor_variable))-1)
)
write.csv(mapping, file = fn, row.names = FALSE)
}
