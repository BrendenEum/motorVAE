summary_all = summary(lm_all)
coef_table_all = coef(summary_all)
# Extract p-values (excluding intercept)
estimates_all <- coef_table_all[-1, "Estimate"]
pvals_all <- coef(summary_all)[-1, "Pr(>|t|)"]  # drop intercept row
# Apply Bonferroni correction
pvals_bonf_all <- p.adjust(pvals_all, method = "bonferroni")
# Combine results
results_all <- data.frame(
Variable = names(pvals_all),
Estimate = estimates_all,
Raw_p = pvals_all,
Bonferroni_p = pvals_bonf_all,
Sig_0.01 = as.numeric(pvals_bonf_all < 0.01),
Sig_0.05 = as.numeric(pvals_bonf_all < 0.05),
Sig_0.10 = as.numeric(pvals_bonf_all < 0.10)
)
rownames(results_all) = NULL
print(results_all)
